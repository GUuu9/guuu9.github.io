{
  "name": "electron-phaser",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "main": "dist-electron/backend/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild src/backend/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/backend/preload.cjs --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "npm run build && cross-env NODE_ENV=development electron .",
    "electron:start": "npm run build && cross-env NODE_ENV=production electron .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "cross-env": "7.0.3",
    "electron": "45.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
