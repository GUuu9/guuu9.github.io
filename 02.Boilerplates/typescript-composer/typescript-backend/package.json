{
  "name": "typescript-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "tsx watch src/backend/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run check && tsc -p tsconfig.build.json && node scripts/copy-config.mjs",
    "start": "node dist/backend/index.js"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
